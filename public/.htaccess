<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow all methods for admin save (fix 405 on Hostinger LiteSpeed/Nginx)
    <Limit GET POST PUT DELETE PATCH OPTIONS HEAD>
        Require all granted
    </Limit>
    <LimitExcept GET POST PUT DELETE PATCH OPTIONS HEAD>
        Require all granted
    </LimitExcept>

    # Handle preflight
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header always set Access-Control-Allow-Headers "X-CSRF-TOKEN, X-Requested-With, Content-Type, Accept"
</IfModule>