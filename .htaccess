<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/direction-a-motion/

    # Stop jika URL sudah dimulai "public/" - cegah infinite loop
    RewriteRule ^public/ - [L]

    # Arahkan SEMUA request (termasuk root "/") ke folder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>