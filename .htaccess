<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/direction-a-motion/

    # Stop if already in public/ - prevents loop when serving static files
    RewriteRule ^public/ - [L]

    # Serve static files (CSS, JS, images) from the public/ subfolder
    RewriteRule ^(assets|_build\.js|_inline-gl\.js|hero-preview\.png|sitemap\.xml)(.*)$ public/$1$2 [L]

    # For actual files (like our index.php), stop and serve directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests to our proxy index.php
    RewriteRule ^ index.php [L]
</IfModule>