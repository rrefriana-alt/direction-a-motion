<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/direction-a-motion/

    # Jangan rewrite jika request sudah menuju folder public/ (cegah infinite loop)
    RewriteRule ^public/ - [L]

    # Jangan rewrite jika sudah berupa file atau folder yang ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Arahkan semua request lainnya ke folder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>